@model UAS_C__Lanjutan.Models.Entity.ShopProduct
@using UAS_C__Lanjutan.Models.Entity

@{
    Layout = null;
    var user = ViewBag.CurrentUser as User;
    int cartCount = ViewBag.CartCount ?? 0;
    var reviews = ViewBag.Reviews as List<ShopProductReview> ?? new List<ShopProductReview>();
    var userDict = ViewBag.UserDict as Dictionary<int, string> ?? new Dictionary<int, string>();
    var related = ViewBag.RelatedProducts as List<ShopProduct> ?? new List<ShopProduct>();

    // Group variants by type
    var variantGroups = Model.Variants != null ? Model.Variants.GroupBy(v => v.VariantType).ToList() : new List<IGrouping<string, ShopProductVariant>>();
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name - Kyu Dessert & Cafe</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="@Url.Content("~/Content/dessert-shop.css")?v=@DateTime.Now.Ticks" />
</head>
<body class="shop-body">

    <!-- NAVBAR -->
    <nav class="shop-navbar">
        <div class="shop-nav-container">
            <a href="@Url.Action("Index", "Shop")" class="shop-brand">
                <span class="shop-brand-icon">☕</span>
                <span class="shop-brand-name">Kyu Dessert & Cafe</span>
            </a>

            <div class="shop-nav-links">
                <a href="@Url.Action("Index", "Shop")" class="nav-shop-btn nav-shop-btn-outline">
                    <span>⬅️</span>
                    <span>Kembali ke Menu</span>
                </a>

                <a href="@Url.Action("Cart", "Shop")" class="nav-shop-btn nav-shop-btn-primary">
                    <span>🛒</span>
                    <span>Keranjang</span>
                    <span class="cart-counter-badge" id="navCartCount">@cartCount</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- PRODUCT DETAIL MAIN CONTAINER -->
    <div class="product-detail-container">
        <div class="product-detail-card">
            <!-- Left: Gallery Image -->
            <div class="detail-gallery-wrapper">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="detail-gallery-img" id="mainProductImg" />
                @if (!string.IsNullOrEmpty(Model.BadgeText))
                {
                    <div class="badge-tag-floating">@Model.BadgeText</div>
                }
            </div>

            <!-- Right: Product Configurator & Info -->
            <div class="detail-info-wrapper">
                <div class="detail-category-tag">
                    @(Model.Category != null ? Model.Category.Name : "Artisan Dessert")
                </div>

                <h1 class="detail-title">@Model.Name</h1>

                <div class="product-meta-row" style="margin-bottom: 15px;">
                    <div class="product-rating-stars">
                        <span style="font-size: 1.1rem;">★</span>
                        <span style="font-size: 1rem;">@Model.Rating.ToString("F1")</span>
                        <span style="color: var(--cafe-text-subtle); font-weight: normal;">(@Model.TotalReviews ulasan penikmat cafe)</span>
                    </div>
                    <div style="font-size: 0.88rem; color: var(--cafe-text-muted);">
                        <span>Terjual <strong>@Model.TotalSold</strong></span>
                        <span style="margin: 0 6px;">•</span>
                        <span>Stok: <strong>@Model.Stock</strong></span>
                    </div>
                </div>

                <div class="detail-price-box">
                    <span class="detail-current-price" id="displayProductPrice">Rp @Model.Price.ToString("N0")</span>
                    @if (Model.OriginalPrice.HasValue && Model.OriginalPrice.Value > Model.Price)
                    {
                        <span class="original-price-strike" style="font-size: 1rem;">Rp @Model.OriginalPrice.Value.ToString("N0")</span>
                    }
                </div>

                <p style="color: var(--cafe-text-muted); line-height: 1.6; font-size: 0.95rem; margin-bottom: 18px;">
                    @Model.FullDescription
                </p>

                <!-- Variant Selectors -->
                @if (variantGroups.Any())
                {
                    foreach (var grp in variantGroups)
                    {
                        <div class="variant-section-title">Pilihan @grp.Key:</div>
                        <div class="variant-chips-group">
                            @{ int vIdx = 0; }
                            @foreach (var variant in grp)
                            {
                                <label class="variant-radio-btn">
                                    <input type="radio" name="variant_@grp.Key" value="@variant.VariantName" data-extra="@variant.ExtraPrice" @(vIdx == 0 ? "checked" : "") onchange="updatePriceCalculation()" />
                                    <span class="variant-label">
                                        @variant.VariantName
                                    </span>
                                </label>
                                vIdx++;
                            }
                        </div>
                    }
                }

                <!-- Custom Note Input -->
                <div class="variant-section-title" style="margin-top: 20px;">
                    ✍️ Catatan Khusus / Pesan Kartu & Lilin (Opsional):
                </div>
                <input type="text" id="txtCustomNote" class="custom-note-input" placeholder="Contoh: 'Happy Birthday Sarah! Tambah 2 lilin batang'" maxlength="200" />

                <!-- Quantity & Add to Cart -->
                <div style="display: flex; align-items: center; gap: 20px; margin-top: 24px;">
                    <div class="variant-section-title" style="margin: 0;">Jumlah:</div>
                    <div class="qty-stepper-wrapper">
                        <button type="button" class="btn-stepper" onclick="changeDetailQty(-1)">-</button>
                        <input type="number" id="detailQty" class="input-stepper-qty" value="1" min="1" max="@Model.Stock" readonly />
                        <button type="button" class="btn-stepper" onclick="changeDetailQty(1)">+</button>
                    </div>
                </div>

                <div class="detail-actions-row">
                    <button type="button" class="btn-action-cart btn-action-cart-outline" onclick="handleAddToCart(false)">
                        <span>🛒</span>
                        <span>Tambah ke Keranjang</span>
                    </button>
                    <button type="button" class="btn-action-cart btn-action-cart-fill" onclick="handleAddToCart(true)">
                        <span>⚡</span>
                        <span>Pesan Sekarang</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- REVIEWS SECTION -->
        <div style="background: var(--cafe-card-bg); border-radius: var(--cafe-radius); border: 1.5px solid var(--cafe-border); box-shadow: var(--cafe-shadow-sm); padding: 32px; margin-top: 35px;">
            <h3 style="font-weight: 700; color: var(--cafe-espresso); margin-bottom: 22px; display: flex; align-items: center; gap: 10px;">
                <span>⭐</span>
                <span>Ulasan Penikmat Dessert (@reviews.Count)</span>
            </h3>

            @if (!reviews.Any())
            {
                <p style="color: var(--cafe-text-muted); font-style: italic;">Belum ada ulasan untuk menu artisan ini. Jadilah penikmat pertama yang mencobanya!</p>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    @foreach (var rev in reviews)
                    {
                        string revAuthor = userDict.ContainsKey(rev.UserId) ? userDict[rev.UserId] : "Pengunjung Cafe";
                        <div style="background: var(--cafe-cream-soft); border: 1.5px solid var(--cafe-border); border-radius: var(--cafe-radius-sm); padding: 18px;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <span style="background: var(--cafe-gold-light); color: var(--cafe-toffee); width: 34px; height: 34px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem; border: 1px solid var(--cafe-border);">@revAuthor.Substring(0, 1).ToUpper()</span>
                                    <span style="font-weight: 700; color: var(--cafe-espresso);">@revAuthor</span>
                                </div>
                                <div style="color: #E5A33C; font-size: 0.9rem;">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <span>@(s <= rev.Rating ? "★" : "☆")</span>
                                    }
                                    <span style="color: var(--cafe-text-subtle); font-size: 0.8rem; margin-left: 6px;">@rev.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <p style="margin: 0; color: var(--cafe-text-muted); font-size: 0.92rem; line-height: 1.5;">@rev.Comment</p>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- RELATED PRODUCTS -->
        @if (related.Any())
        {
            <div style="margin-top: 45px;">
                <h3 style="font-weight: 700; color: var(--cafe-espresso); margin-bottom: 22px;">☕ Menu Pilihan Cafe Lainnya</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 22px;">
                    @foreach (var rel in related)
                    {
                        <div class="product-card">
                            <div class="product-img-wrapper" style="padding-top: 65%;">
                                <img src="@rel.ImageUrl" alt="@rel.Name" class="product-img" loading="lazy" />
                            </div>
                            <div class="product-card-body" style="padding: 16px;">
                                <a href="@Url.Action("ProductDetail", "Shop", new { id = rel.Id })" class="product-card-title" style="font-size: 1.05rem;">@rel.Name</a>
                                <div class="product-card-footer" style="padding-top: 10px;">
                                    <span class="current-price-label" style="font-size: 1.1rem;">Rp @rel.Price.ToString("N0")</span>
                                    <a href="@Url.Action("ProductDetail", "Shop", new { id = rel.Id })" class="btn-add-cart-quick" style="width: 38px; height: 38px; font-size: 1rem;">🛒</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var baseProductPrice = @Model.Price;

        function updatePriceCalculation() {
            var extraTotal = 0;
            var checkedVariants = document.querySelectorAll('input[type="radio"]:checked');
            checkedVariants.forEach(function(r) {
                var extra = parseFloat(r.getAttribute('data-extra')) || 0;
                extraTotal += extra;
            });

            var totalPrice = baseProductPrice + extraTotal;
            document.getElementById('displayProductPrice').innerText = 'Rp ' + totalPrice.toLocaleString('id-ID');
        }

        function changeDetailQty(delta) {
            var qtyInput = document.getElementById('detailQty');
            var curVal = parseInt(qtyInput.value) || 1;
            var maxStock = @Model.Stock;
            var newVal = curVal + delta;
            if (newVal >= 1 && newVal <= maxStock) {
                qtyInput.value = newVal;
            }
        }

        function getSelectedVariantsString() {
            var parts = [];
            var checkedVariants = document.querySelectorAll('input[type="radio"]:checked');
            checkedVariants.forEach(function(r) {
                parts.push(r.value);
            });
            return parts.join(' | ');
        }

        function handleAddToCart(isBuyNow) {
            var productId = @Model.Id;
            var variantStr = getSelectedVariantsString();
            var qty = parseInt(document.getElementById('detailQty').value) || 1;
            var note = document.getElementById('txtCustomNote').value.trim();

            var formData = new FormData();
            formData.append('productId', productId);
            formData.append('variant', variantStr);
            formData.append('qty', qty);
            formData.append('customNote', note);

            fetch('@Url.Action("AddToCart", "Shop")', {
                method: 'POST',
                body: formData
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data.requireLogin) {
                    Swal.fire({
                        icon: 'info',
                        title: 'Masuk Akun',
                        text: data.message,
                        confirmButtonText: 'Login Sekarang',
                        confirmButtonColor: '#9E5825',
                        showCancelButton: true,
                        cancelButtonText: 'Nanti Saja'
                    }).then(function(result) {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Account")?returnUrl=' + encodeURIComponent(window.location.pathname);
                        }
                    });
                    return;
                }

                if (data.success) {
                    // Update badge
                    document.getElementById('navCartCount').innerText = data.cartCount;

                    if (isBuyNow) {
                        window.location.href = '@Url.Action("Cart", "Shop")';
                    } else {
                        Swal.fire({
                            icon: 'success',
                            title: '☕ Ditambahkan!',
                            text: data.message,
                            confirmButtonText: 'Lihat Keranjang',
                            confirmButtonColor: '#9E5825',
                            showCancelButton: true,
                            cancelButtonText: 'Lanjut Pilih Menu'
                        }).then(function(result) {
                            if (result.isConfirmed) {
                                window.location.href = '@Url.Action("Cart", "Shop")';
                            }
                        });
                    }
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: data.message || 'Gagal menambahkan ke pesanan.',
                        confirmButtonColor: '#9E5825'
                    });
                }
            })
            .catch(function(err) {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Terjadi kesalahan koneksi server.',
                    confirmButtonColor: '#9E5825'
                });
            });
        }
    </script>
</body>
</html>
