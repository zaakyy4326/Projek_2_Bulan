@{
    Layout = null;
    ViewBag.Title = "404 - Not Found";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Halaman Tidak Ditemukan | Kyu's Dessert World</title>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka+One&family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            background: radial-gradient(circle at 50% 50%, #2e2419 0%, #15100a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Nunito', sans-serif;
            color: #fff;
            padding: 20px;
            margin: 0;
        }
        .error-card {
            background: rgba(45, 30, 20, 0.95);
            border: 4px solid #f1c40f;
            border-radius: 25px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.6);
            max-width: 520px;
            width: 100%;
            padding: 40px 30px;
            text-align: center;
        }
        .error-code {
            font-family: 'Fredoka One', cursive;
            font-size: 5rem;
            color: #f1c40f;
            text-shadow: 0 4px 10px rgba(241, 196, 15, 0.4);
            line-height: 1;
            margin-bottom: 10px;
        }
        .error-emoji {
            font-size: 4rem;
            margin-bottom: 15px;
            display: inline-block;
        }
        .error-title {
            font-family: 'Fredoka One', cursive;
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 12px;
        }
        .error-desc {
            color: #ecd9c6;
            font-size: 1rem;
            margin-bottom: 25px;
            line-height: 1.6;
        }
        .btn-home {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white !important;
            text-decoration: none;
            font-weight: bold;
            padding: 12px 30px;
            border-radius: 30px;
            display: inline-block;
            transition: all 0.3s ease;
            box-shadow: 0 6px 15px rgba(230, 126, 34, 0.35);
        }
        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(230, 126, 34, 0.5);
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="error-emoji">🧁🔍</div>
        <div class="error-code">404</div>
        <h1 class="error-title">Halaman Tidak Ditemukan (Not Found)</h1>
        <p class="error-desc">
            Ups! Menu dessert atau halaman yang kamu cari sepertinya sudah dipindahkan atau tidak pernah ada di toko kami.
        </p>
        <a href="@Url.Action("Index", "MainMenu")" class="btn-home">🏠 Kembali ke Menu Utama</a>
    </div>
</body>
</html>
