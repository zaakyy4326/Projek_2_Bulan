@model UAS_C__Lanjutan.Models.Entity.User

@{
    ViewBag.Title = "Konfirmasi Hapus Pengguna - " + Model.Username;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card border-danger border-opacity-25">
            <!-- Header Warning -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <div style="font-size: 3rem; margin-bottom: 8px;">⚠️</div>
                <h3 class="fw-bold text-danger mb-1">Nonaktifkan Akun Pengguna?</h3>
                <p class="text-muted small mb-0">
                    Akun ini akan dinonaktifkan (*soft-delete*) dan pengguna tidak akan bisa login ke dalam permainan.
                </p>
            </div>

            <!-- User Info Summary Card -->
            <div class="p-3 rounded-4 mb-4" style="background: #FFF5F5; border: 1.5px solid #FFD6D6;">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div style="width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: #FFE0E6; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; border: 2px solid #FF8EAA;">
                        @if (!string.IsNullOrEmpty(Model.Avatar))
                        {
                            <img src="@Url.Content(Model.Avatar)" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <span>🧑‍🍳</span>
                        }
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0" style="color: #5D4037;">@Model.Username</h5>
                        <div class="text-muted small">@(string.IsNullOrEmpty(Model.Email) ? "Tidak ada email" : Model.Email)</div>
                    </div>
                </div>

                <div class="row g-2 text-muted small">
                    <div class="col-6">💰 Koin: <strong>@Model.TotalCoins.ToString("N0")</strong></div>
                    <div class="col-6">🏆 High Score: <strong>@Model.HighScoreBb</strong></div>
                    <div class="col-6">🛡️ Role: <strong>@Model.Role</strong></div>
                    <div class="col-6">📅 Bergabung: <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong></div>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-center gap-3">
                    <a href="@Url.Action("Index", "Users")" class="btn btn-secondary px-4 py-2" style="border-radius: 50px; font-weight: 600;">
                        ❌ Batal
                    </a>
                    <button type="submit" class="btn btn-danger px-4 py-2" style="border-radius: 50px; font-weight: 600; background: linear-gradient(135deg, #FF4B72, #D9383A); border: none;">
                        🗑️ Ya, Nonaktifkan Akun
                    </button>
                </div>
            }
        </div>
    </div>
</div>
