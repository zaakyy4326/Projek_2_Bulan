		{
			"name": "E-Commerce Kafe (Shop)",
			"item": [
				{
					"name": "1. Katalog Menu (Paginasi, Filter & Sort A-Z)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/Shop/Index?cat=&search=&sort=name_asc&page=1&pageSize=8",
							"host": ["{{baseUrl}}"],
							"path": ["Shop", "Index"],
							"query": [
								{ "key": "cat", "value": "" },
